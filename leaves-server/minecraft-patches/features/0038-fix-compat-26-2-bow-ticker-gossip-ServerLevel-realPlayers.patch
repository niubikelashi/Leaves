Subject: [PATCH] fix(compat): 26.2 修正 bow 弹药参数/蜘蛛重复注解/区块 ticker 包装可见性/gossip 字段与 ServerLevel realPlayers


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2664,6 +2664,13 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         return this.players;
     }
 
+    // Leaves start - skip bot
+    public List<ServerPlayer> realPlayers() {
+        // 26.2 compat: bot 子系统已延期，此时 realPlayers 等价于 players（docs/deferred-26.2/REMOVED-FEATURES.md）
+        return this.players;
+    }
+    // Leaves end - skip bot
+
     @Override
     public void updatePOIOnBlockStateChange(final BlockPos pos, final BlockState oldState, final BlockState newState) {
         Optional<Holder<PoiType>> oldType = PoiTypes.forState(oldState);
